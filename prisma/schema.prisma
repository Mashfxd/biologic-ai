generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --- ENUMS (Listas estrictas de valores) ---
enum Role {
  ADMIN
  OPERATOR
}

enum Gender {
  MACHO
  HEMBRA
}

enum AnimalStatus {
  HEALTHY
  SICK
  SOLD
  DECEASED
}

// --- MODELOS ---
model User {
  id       Int    @id @default(autoincrement())
  username String @unique
  email    String @unique
  password String
  role     Role   @default(OPERATOR) // Validado por Enum
}

model Animal {
  id            Int          @id @default(autoincrement())
  name          String
  species       String
  breed         String
  birthDate     DateTime     
  gender        Gender       // Validado por Enum
  status        AnimalStatus @default(HEALTHY) // Validado por Enum
  purpose       String?
  litterCode    String?
  readyForMating Boolean     @default(false)
  currentWeight Float      
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt      
  health_logs   HealthLog[]
  feeding_logs  FeedingLog[]
  growth_logs   GrowthLog[]
  
  // Relaciones Productivas
  partosComoMadre ReproductionLog[] @relation("MotherRelation")
  partosComoPadre ReproductionLog[] @relation("FatherRelation")
}

model HealthLog {
  id         Int      @id @default(autoincrement())
  animal_id  Int
  animal     Animal   @relation(fields: [animal_id], references: [id])
  date       DateTime @default(now())
  diagnostic String
  treatment  String
}

model GrowthLog {
  id        Int      @id @default(autoincrement())
  animal_id Int
  animal    Animal   @relation(fields: [animal_id], references: [id])
  date      DateTime @default(now())
  weight    Float
}

model FeedingLog {
  id        Int      @id @default(autoincrement())
  animal_id Int
  animal    Animal   @relation(fields: [animal_id], references: [id])
  date      DateTime @default(now())
  food_type String
  quantity  Float
}

model ReproductionLog {
  id             Int       @id @default(autoincrement())
  poza           String    
  matingDate     DateTime? 
  birthDate      DateTime  
  bornAlive      Int       
  bornDead       Int       
  avgBirthWeight Float     
  weaningDate    DateTime? 
  observations   String?   
  createdAt      DateTime  @default(now())

  motherId       Int
  mother         Animal    @relation("MotherRelation", fields: [motherId], references: [id])

  fatherId       Int?
  father         Animal?   @relation("FatherRelation", fields: [fatherId], references: [id])
}